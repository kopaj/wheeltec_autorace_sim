<?xml version="1.0" ?>

<sdf version="1.8">

  <model name="racetrack">

    <!--
      The racetrack is static and cannot be moved by physics.
    -->

    <static>true</static>


    <link name="track_link">

      <!-- ===================================================== -->
      <!-- Physical driving surface                              -->
      <!-- ===================================================== -->

      <!--
        A thin collision box is used instead of a collision
        plane so that the vehicle has a stable physical surface.

        The top of the box is exactly at z = 0.
      -->

      <collision name="track_collision">

        <pose>
          0 0 -0.01 0 0 0
        </pose>

        <geometry>

          <box>
            <size>
              7.0 7.0 0.02
            </size>
          </box>

        </geometry>

        <surface>

          <friction>

            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>

          </friction>

        </surface>

      </collision>


      <!-- ===================================================== -->
      <!-- Visible textured surface                              -->
      <!-- ===================================================== -->

      <visual name="track_visual">

        <!--
          Slightly above z=0 to avoid z-fighting.
        -->

        <pose>
          0 0 0.001 0 0 0
        </pose>

        <geometry>

          <plane>

            <normal>
              0 0 1
            </normal>

            <size>
              7.0 7.0
            </size>

          </plane>

        </geometry>


        <material>

  <ambient>
    1 1 1 1
  </ambient>

  <diffuse>
    1 1 1 1
  </diffuse>

  <specular>
    0 0 0 1
  </specular>

  <pbr>

    <metal>

      <albedo_map>
        model://racetrack/materials/textures/course.png
      </albedo_map>

      <metalness>
        0.0
      </metalness>

      <roughness>
        1.0
      </roughness>

    </metal>

  </pbr>

</material>

      </visual>

    </link>

  </model>

</sdf>