<?xml version="1.0"?>
<package format="3">
  <name>wheeltec_autorace_evaluation</name>
  <version>0.1.0</version>
  <description>Independent, read-only ground-truth tracking evaluation for ROS 2 Humble and Gazebo Fortress.</description>
  <maintainer email="maintainer@example.com">Wheeltec project maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>ignition-transport11</depend>
  <depend>ignition-msgs8</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
