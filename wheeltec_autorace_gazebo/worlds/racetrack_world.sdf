<?xml version="1.0" ?>

<sdf version="1.8">

  <world name="wheeltec_autorace">


    <!-- ===================================================== -->
    <!-- Physics                                               -->
    <!-- ===================================================== -->

    <physics
      name="physics"
      type="ignored">

      <max_step_size>
        0.001
      </max_step_size>

      <real_time_factor>
        1.0
      </real_time_factor>

    </physics>


    <!-- ===================================================== -->
    <!-- Gazebo Fortress systems                               -->
    <!-- ===================================================== -->

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>


    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>


    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>


    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">

      <render_engine>
        ogre2
      </render_engine>

    </plugin>


    <!-- ===================================================== -->
    <!-- Environment                                           -->
    <!-- ===================================================== -->

    <gravity>
      0 0 -9.81
    </gravity>


    <scene>

      <ambient>
        0.8 0.8 0.8 1
      </ambient>

      <background>
        0.25 0.25 0.25 1
      </background>

      <shadows>
        false
      </shadows>

      <grid>
        false
      </grid>

    </scene>


    <!-- ===================================================== -->
    <!-- Lighting                                              -->
    <!-- ===================================================== -->

    <light
      type="directional"
      name="sun">

      <cast_shadows>
        false
      </cast_shadows>

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        1 1 1 1
      </diffuse>

      <specular>
        0.1 0.1 0.1 1
      </specular>

      <attenuation>

        <range>
          1000
        </range>

        <constant>
          0.9
        </constant>

        <linear>
          0.01
        </linear>

        <quadratic>
          0.001
        </quadratic>

      </attenuation>

      <direction>
        -0.5 0.5 -1
      </direction>

    </light>


    <!-- ===================================================== -->
    <!-- 2D textured racetrack                                 -->
    <!-- ===================================================== -->

    <include>

      <uri>
        package://wheeltec_autorace_description/models/racetrack
      </uri>

      <name>
        racetrack
      </name>

      <pose>
        0 0 0 0 0 0
      </pose>

    </include>


    <!-- ===================================================== -->
    <!-- Wheeltec / Roboworks                                  -->
    <!-- ===================================================== -->

    <include>

      <uri>
        package://wheeltec_autorace_description/models/roboworks
      </uri>

      <name>
        roboworks
      </name>

      <!--
        Initial position.
        Fine tuning will be done after visually inspecting
        the textured track.
      -->

      <pose>
        0.10 -3.1150 0.08 0 0 0
      </pose>

    </include>


  </world>

</sdf>